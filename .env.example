# Optional. The prototype runs WITHOUT these.
# Only use the frontend publishable key here. NEVER put a secret/service-role key in any VITE_ variable
# (everything prefixed VITE_ is shipped to the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_BUCKET=our-little-memories

# Spotify Developer App Client ID only (never put a Spotify client secret in VITE_ variables).
VITE_SPOTIFY_CLIENT_ID=
# Must exactly match a Spotify Dashboard redirect URI. Use an HTTPS production origin.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/
